# Normalise line endings.
#
# Without this, a Windows clone rewrites every file to CRLF on checkout and the diffs against a
# macOS or Linux clone become unreadable. Worse for us specifically: a CRLF-terminated shell
# script fails with "bad interpreter: /usr/bin/env bash^M", and a CRLF-terminated YAML file can
# carry a trailing \r into a control_id or a population definition — which then silently fails to
# match anywhere it is compared. That is a correctness problem in a control inventory, not a
# cosmetic one.

* text=auto eol=lf

# Anything executed by an interpreter, or parsed for exact string equality, is pinned to LF.
*.sh      text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.sql     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.json    text eol=lf
*.md      text eol=lf

# Windows-only files keep CRLF so they open correctly in Notepad and legacy editors.
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Never touch these.
*.png     binary
*.jpg     binary
*.pdf     binary
*.xlsx    binary
*.zip     binary
